# —— 运行时 & 本地数据（含用户真实数据，绝不提交）——
backups/
logs/
*.log

# —— 凭据 / 敏感文件（哪怕空白也一律不入库）——
.env
.env.*
*.key
*.pem
*credential*
*secret*

# —— 依赖 / 构建产物 ——
node_modules/
dist/
build/

# —— 受管 npm 安装目录（可经「安装 / 更新 Harness」重建，与 config.json 同源、可再生，不入库）——
dsh-install/

# —— 系统 / 编辑器临时文件 ——
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*~

# —— 本地机器相关配置（动态生成，含本机绝对路径，不入库；缺失时服务自动用默认值重建）——
config.json